{
  "name": "maskmcp",
  "version": "0.1.0",
  "description": "Servidor MCP local-first para gestionar secretos y credenciales de forma segura",
  "type": "module",
  "bin": {
    "maskmcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test:vault": "tsx src/core/test-vault.ts",
    "test:tools": "tsx src/tools/test-tools.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "secrets",
    "credentials",
    "local-first"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
